PORT=4000
APP_NAME=Online Medical Store API
NODE_ENV=development

# Database (use a hosted MySQL provider, e.g. PlanetScale, Railway, Aiven, when deploying to Vercel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=online_medical_store

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Online Medical Store
EMAIL_SECURE=false

# Frontend URL (used for links in emails, etc.)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed origins, or "*" to allow all
CORS_ORIGIN=http://localhost:3000

# File uploads. On Vercel the filesystem is read-only except /tmp, and /tmp
# is wiped between invocations, so files uploaded in production will NOT
# persist — point this (and the upload logic) at S3/Cloudinary/etc. for a
# real deployment. Leave unset locally.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Default admin bootstrap
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
ENABLE_DEFAULT_ADMIN_BOOTSTRAP=false
